# 前端 --mode test 的公开配置（开发服务器、build:test、vitest），进版本库（assembly 的 AS-09）。
# 只放 VITE_ 开头的公开配置。不写 VITE_AG_GRID_LICENSE_KEY：本文件优先于根目录 .env，写了（即使为空）也会覆盖 .env 中的授权。
# 本机要改其中的值时写在 .env.test.local（不进版本库）。
# 应用的基础路径，子目录要以 / 结尾，例如 /admin/
VITE_BASE_URL=/
VITE_APP_TITLE=华益低代码平台
# 图标名前缀；本地 svg 图标的前缀必须以 VITE_ICON_PREFIX 开头
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local
# 首页路由
VITE_ROUTE_HOME=home
# 菜单没有图标时的默认图标
VITE_MENU_ICON=mdi:menu
# 开发服务器是否代理后端请求
VITE_HTTP_PROXY=Y
# 后端地址
VITE_SERVICE_BASE_URL=http://localhost:8080
# 其他后端地址（json5）
VITE_OTHER_SERVICE_BASE_URL={}
# vue-router 模式：hash | history | memory
VITE_ROUTER_HISTORY_MODE=history
# 构建时是否生成 sourcemap
VITE_SOURCE_MAP=N
# 浏览器存储键的前缀
VITE_STORAGE_PREFIX=SOY_
# 构建产物是否自动检测新版本
VITE_AUTOMATICALLY_DETECT_UPDATE=Y
# 开发服务器是否在终端打印代理地址
VITE_PROXY_LOG=Y
# 开发时 Vue DevTools 打开源码用的编辑器
VITE_DEVTOOLS_LAUNCH_EDITOR=code
