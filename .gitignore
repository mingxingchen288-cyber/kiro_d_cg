# 本地环境与密钥：连接信息只放在 .env，不进版本库
.env
.env.*
!.env.example
# 前端的公开配置（只有 VITE_ 开头的变量，没有密钥；AG Grid 授权放在 .env），前端只读根目录的环境文件（assembly 的 AS-09）。
# .env.test.local、.env.prod.local 是本机覆盖，仍被上面的 .env.* 忽略。
!/.env.test
!/.env.prod

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.hypothesis/
.import_linter_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 测试与追踪产物
.reports/
backend/.reports/

# Node / 前端
node_modules/
dist/
.vite/
coverage/
playwright-report/
test-results/

# Rust
rules-core/target/
rules-core/pkg/

# 本地工具链（经同意后下载，不进版本库）
.tools/

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
