{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/main.ts", "vite.config.ts", "uno.config.ts", "build/**/*.ts", "src/styles/scss/global.scss"],
      "project": ["src/**/*.{ts,vue,scss}", "build/**/*.ts"],
      "ignoreDependencies": ["ag-grid-vue3"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": ["src/typings/**/*.d.ts"],
  "ignoreBinaries": ["githublogen"]
}