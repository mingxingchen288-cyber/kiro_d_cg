{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "uno.config.ts",
        "build/**/*.ts",
        "src/styles/scss/global.scss"
      ],
      "project": [
        "src/**/*.{ts,vue,scss}",
        "build/**/*.ts"
      ],
      "ignoreDependencies": [
        "ag-grid-vue3",
        "@elegant-router/types",
        "uno.css",
        "@iconify/json"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,vue}"
      ]
    },
    "packages/scripts": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "npm-check-updates"
      ]
    }
  },
  "ignore": [
    "src/typings/**/*.d.ts"
  ],
  "ignoreBinaries": [
    "githublogen"
  ]
}
