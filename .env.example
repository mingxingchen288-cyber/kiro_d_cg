# 复制为 .env 后填写。.env 不进版本库。

# 后端运行方式：memory 用内存假实现（无需数据库）；oracle 用真实 Oracle + Redis
PLATFORM_BACKEND=memory

# 新平台开发库（d_cg）
PLATFORM_DB_USER=d_cg
PLATFORM_DB_PASSWORD=
PLATFORM_DB_DSN=192.168.11.5:1521/orcl

# 旧系统库 cmx 不另设账号：用 d_cg 在只读事务中读取 CMX.表名

# Redis
PLATFORM_REDIS_URL=redis://127.0.0.1:6379/0
PLATFORM_REDIS_NAMESPACE=cost-platform

# 允许的浏览器来源（WebSocket 与 CSRF 校验用），多个用逗号分隔
PLATFORM_ALLOWED_ORIGINS=http://localhost:9527

# SQL 追踪输出目录（为空则不写文件）
SQL_PROFILE_DIR=

# 前端：复用旧项目当前 AG Grid 授权；实际值只填写在本地 .env 或构建环境中。
VITE_AG_GRID_LICENSE_KEY=
# 会话空闲多少分钟后过期（只有用户自己的写入和查询会顺延）
PLATFORM_SESSION_IDLE_MINUTES=120
# 等待单据锁的秒数
PLATFORM_LOCK_WAIT_SECONDS=5
# 同一请求键仍在处理时等待的秒数
PLATFORM_REQUEST_WAIT_SECONDS=5
