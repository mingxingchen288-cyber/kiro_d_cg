# Dependency rules: see docs section 3 of the architecture document.
# Keep this file ASCII-only: import-linter reads it with the system locale encoding.
[importlinter]
root_package = cost_platform

[importlinter:contract:business-modules-independent]
name = Business modules do not import each other
type = independence
modules =
    cost_platform.config
    cost_platform.identity
    cost_platform.authz
    cost_platform.pipeline
    cost_platform.approval
    cost_platform.operations
    cost_platform.delivery
    cost_platform.realtime
    cost_platform.queries
    cost_platform.db_core
    cost_platform.migration
    cost_platform.orchestration

[importlinter:contract:layers]
name = Only assembly imports business modules; business modules depend only on contracts
type = layers
# exhaustive: every direct child of cost_platform must be listed below, so a new
# module outside these layers cannot bypass the rules.
containers =
    cost_platform
exhaustive = true
layers =
    assembly
    config | identity | authz | pipeline | approval | operations | delivery | realtime | queries | db_core | migration | orchestration
    contracts

[importlinter:contract:root-package]
name = The root package imports no platform module
type = forbidden
# as_packages = False: the source is cost_platform/__init__.py only, not its sub-packages.
source_modules =
    cost_platform
forbidden_modules =
    cost_platform.**
as_packages = False

# Plugin wiring (docs: .reports/modules/plugin-spec.md section 1). Checked by backend/tests/architecture/test_imports.py.

[importlinter:contract:plugin-imports]
name = A module's plugin.py imports only contracts and its own module
type = forbidden
# Every cost_platform.<module>.plugin overlaps its own package in the list below, and the
# forbidden contract skips overlapping pairs, so a plugin may import its own module.
# Only direct imports: what the plugin's own module imports is covered by the contracts above.
source_modules =
    cost_platform.*.plugin
forbidden_modules =
    cost_platform.assembly
    cost_platform.config
    cost_platform.identity
    cost_platform.authz
    cost_platform.pipeline
    cost_platform.approval
    cost_platform.operations
    cost_platform.delivery
    cost_platform.realtime
    cost_platform.queries
    cost_platform.db_core
    cost_platform.migration
    cost_platform.orchestration
allow_indirect_imports = true

[importlinter:contract:assembly-imports]
name = assembly imports only the plugin.py of each module
type = forbidden
# Also allowed: contracts, assembly itself, third-party packages (cost_rules_core, fastapi ...),
# none of which are in forbidden_modules.
source_modules =
    cost_platform.assembly
forbidden_modules =
    cost_platform.config
    cost_platform.identity
    cost_platform.authz
    cost_platform.pipeline
    cost_platform.approval
    cost_platform.operations
    cost_platform.delivery
    cost_platform.realtime
    cost_platform.queries
    cost_platform.db_core
    cost_platform.migration
    cost_platform.orchestration
ignore_imports =
    cost_platform.assembly -> cost_platform.*.plugin
    cost_platform.assembly.** -> cost_platform.*.plugin
# The two expressions above may match nothing while the plugins are being written.
unmatched_ignore_imports_alerting = none
allow_indirect_imports = true
